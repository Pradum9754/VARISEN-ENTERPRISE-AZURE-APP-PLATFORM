# ============================================
# Terraform
# ============================================

# Terraform working directory
.terraform/
.terraform.lock.hcl
# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform state lock information
.terraform.tfstate.lock.info

# Terraform plan files
*.tfplan
*.tfplan.json

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# NOTE:
# terraform.tfvars is intentionally tracked.
# .terraform.lock.hcl is intentionally tracked.


